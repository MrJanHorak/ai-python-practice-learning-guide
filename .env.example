# Reference only: the standard-library CLI does not automatically load .env.
# Set variables in PowerShell as described in 06-model-provider-lab.md.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
# Optional separate example for OpenAI-compatible local servers:
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_OPENAI_MODEL=
DOCUMENTINTELLIGENCE_ENDPOINT=
# Leave key empty to use DefaultAzureCredential (requires Azure identity setup).
DOCUMENTINTELLIGENCE_API_KEY=
# Optional Azure OpenAI v1 SDK example (different from the direct OpenAI adapter):
AZURE_OPENAI_V1_BASE_URL=
AZURE_OPENAI_DEPLOYMENT=
